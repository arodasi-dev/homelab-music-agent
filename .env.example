# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai pro git nem pro chat.

# Token da conta de quem administra (a sua). Gere com: openssl rand -hex 24
# Só é lido na PRIMEIRA subida com contas: ali ele vira o token da conta ADMIN_NAME.
# As outras pessoas ganham o token pelo comando `manage.py add-user` (veja o README).
MUSIC_TOKEN=
# Nome da sua conta (2 a 32 letras minúsculas, números, - ou _). Defina ANTES da primeira subida.
ADMIN_NAME=admin
# Endereço do site no GitHub Pages (sem barra no final).
ALLOWED_ORIGIN=https://arodasi-dev.github.io
